{
  "name": "jhs",
  "private": true,
  "version": "1.0.0",
  "homepage": "https://jhs.web.app",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "eslint . && tsc -b --pretty",
    "preview": "vite preview --port 3000 --host 0.0.0.0",
    "deploy": "npm run build && firebase deploy --only hosting",
    "preview:deploy": "npm run build && firebase hosting:channel:deploy preview --only jhs --expires 7d --no-authorized-domains"
  },
  "dependencies": {
    "ogl": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^5.4.1"
  }
}
